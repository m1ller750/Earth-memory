# Copy to .env.local for local overrides. Never commit real secrets.
# With Synapse, keep secrets in the vault and run: synapse run -- npm run dev

# --- Database -----------------------------------------------------------------
# Leave unset to use the embedded PGlite database in ./data/pglite.
# DATABASE_URL=postgres://earth:earth@localhost:5432/earth_memory
# DATA_DIR=./data
# AUTO_SEED=true          # seed reference data automatically when the archive is empty

# --- Demo accounts ------------------------------------------------------------
# Local development seeds five demo accounts (admin, moderator, expert, steward,
# contributor @earthmemory.local) with the password below. In production they are
# only created when DEMO_PASSWORD is set explicitly.
# DEMO_PASSWORD=earth-memory-demo

# --- AI (optional) --------------------------------------------------------------
# Without a key, EARTH AI and the metadata helper run in retrieval-only mode.
# Set one provider key. If both are set, xAI is used unless AI_PROVIDER says otherwise.
# XAI_API_KEY=
# XAI_MODEL=              # optional; otherwise discovered from the xAI models endpoint
# XAI_BASE_URL=           # optional; an OpenAI-compatible endpoint serving Grok (default https://api.x.ai/v1)
# OPENROUTER_API_KEY=     # any model through OpenRouter
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5   # default; e.g. x-ai/grok-4.7 for Grok
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=            # xai | openrouter | anthropic | none

# --- Reference-data importer (npm run ingest) ------------------------------------
# Articles are parsed with Jina Reader through Jina's MCP server. A key is optional and only
# raises Jina's rate limits (https://jina.ai). JINA_MCP_URL defaults to https://mcp.jina.ai/v1.
# JINA_API_KEY=

# --- Uploads ------------------------------------------------------------------
# MAX_UPLOAD_MB=25

# --- Public URL (used in API docs and MCP examples) ----------------------------
# PUBLIC_BASE_URL=http://localhost:3000
